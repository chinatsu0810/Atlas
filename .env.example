# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

RESEND_API_KEY=sk_test_***

# /ai/social（Threads投稿案の生成、運営のみ利用可）で使用
ANTHROPIC_API_KEY=sk-ant-***

# /ai/social のThreads連携（分析担当が、運営のThreadsアカウントの数字を取得する。任意）
# Meta for Developers でThreads use caseのアプリを作成し、「App settings → Basic」の「Threads App ID」「Threads app secret」を設定する。
# ページ上部の「App ID」「App secret」とは別の値。手順は docs/ai/threads-integration.md
THREADS_APP_ID=***
THREADS_APP_SECRET=***
# Metaに登録するコールバックURL。MetaはHTTPSしか受け付けない（localhostは不可）ため、本番のURLを指定する。
# 省略時は BASE_URL + /api/threads/callback。Metaのアプリ設定に登録した値と完全に一致させること
# THREADS_REDIRECT_URI=https://www.atlas-community.jp/api/threads/callback
